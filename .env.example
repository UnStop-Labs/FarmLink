# ============================================================
# FarmLink Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Supabase (Database + Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LINE Messaging API ---
# Get these from https://developers.line.biz/console/
LINE_CHANNEL_ID=your-channel-id
LINE_CHANNEL_SECRET=your-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-access-token
LINE_LIFF_ID=your-liff-app-id

# --- AWS S3 / LocalStack ---
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=localstack       # use "localstack" for local dev
AWS_SECRET_ACCESS_KEY=localstack   # use "localstack" for local dev
AWS_S3_BUCKET=farmlink-media
# For local development with LocalStack:
AWS_ENDPOINT_URL=http://localhost:4566

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API Backend ---
API_PORT=3001
API_JWT_SECRET=change-this-in-production
NODE_ENV=development

# --- LINE Bot ---
BOT_PORT=3000
WEBHOOK_PATH=/webhook
# Public URL for LINE webhooks (use ngrok for local dev)
PUBLIC_URL=https://your-ngrok-url.ngrok.io

# --- LIFF Frontend ---
NEXT_PUBLIC_LIFF_ID=your-liff-app-id
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

# --- AI Engine ---
AI_ENGINE_PORT=8000
SENTINEL_HUB_CLIENT_ID=your-sentinel-hub-client-id
SENTINEL_HUB_CLIENT_SECRET=your-sentinel-hub-client-secret
SENTINEL_HUB_INSTANCE_ID=your-instance-id

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
